from base_plugin import BasePlugin
from hook_utils import get_method
from ui.settings import Switch, Header, Text
from java import jclass

__id__ = "roqigram_premium_badge"
__name__ = "Roqi Premium Badge"
__description__ = "Small crown badge next to the nick in chat list, profile, members and comments."
__author__ = "RoqiGram"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=13.2.1"
__sdk_version__ = ">=1.4.6.4"


class RoqiPremiumBadgePlugin(BasePlugin):
    def is_premium(self):
        try:
            return bool(jclass("com.exteragram.messenger.roqi.RoqiPremium").isPremium())
        except Exception:
            return False

    def on_plugin_load(self):
        if not self.get_setting("show_badge", True) or not self.is_premium():
            return
        try:
            self.badge_handle = self.hook_call_site(
                get_method("org.telegram.ui.Cells.DialogCell", "buildLayout"),
                get_method(
                    "org.telegram.messenger.UserObject",
                    "getUserName",
                    "org.telegram.tgnet.TLRPC$User",
                ),
                self.decorate_name,
            )
        except Exception:
            self.log("Badge hook is unavailable in this build")

    def decorate_name(self, chain):
        name = chain.proceed()
        if not name:
            return name
        return name + " \u265b\u2744"

    def create_settings(self):
        return [
            Header("RoqiGram \u2014 Premium badge"),
            Switch("show_badge", "Show Premium badge", True),
            Text("Visible only when an active RoqiGram Premium key is installed."),
        ]
